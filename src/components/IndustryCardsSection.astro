---
/**
 * 業種別LPへの導線カード（トップLP）。
 *
 * **カードは `industries.ts` から自動生成する**。業種を1件足すとカードが1枚増えるので、
 * このファイルにも content.ts にも業種を書き足す必要はない（2026-08-06 なおき決定の最小差し込み）。
 *
 * カードの中身は既存のコピーから引く（新しい文言を作らない。正本 knowledge/top-copy.md §3）:
 *   業種名  = industry.name
 *   一言    = industry.hero.mainCatch（各業種LPで選定済みのメインキャッチ。**改行位置も維持する**）
 *   対象業務 = industry.cardWork（体言止め・句点なし）
 *   画像alt = industry.hero.image.alt
 *
 * 画像は業種ヒーローの流用。**素の画像は「被写体=左／余白=右」**なので、カードでは
 * 反転せず左寄せで切り抜く（業種ページのヒーローだけがCSSで反転している）。
 * ファイルが無ければ画像を描かず、カードの形だけ保つ（「準備中」の類は出さない）。
 *
 * **カードの中にボタンやリンク文言は置かない**（カード全体がリンク）。
 * 計測はカード側に足さない＝内部遷移なので `?c=` は track.ts の sessionStorage が引き継ぐ。
 */
import SectionHeading from "./ui/SectionHeading.astro";
import JaText from "./ui/JaText.astro";
import { industryCards } from "../data/content";
import { industries, mainCatchKeepFor } from "../data/industries";
import { hasPublicAsset, webpSize } from "../lib/publicAsset";

const base = import.meta.env.BASE_URL.replace(/\/$/, "");

const cards = Object.values(industries).map((industry) => {
  const file = `industry/${industry.hero.image.file}`;
  const size = webpSize(file);
  return {
    href: `${base}/${industry.slug}/`,
    name: industry.name,
    /*
     * 一言は業種LPのメインキャッチそのもの。**折ってはいけない語句も業種LPと同じものを通す**
     * （`mainCatchKeepFor`）。カードは幅が狭いぶん実際に折り返しが起きるのはこちら側なので、
     * ここを通さないとヒーローだけ折り位置が守られてカードで割れる。
     */
    catchLines: industry.hero.mainCatch.map((line) => ({
      text: line,
      keep: mainCatchKeepFor(industry.hero, line),
    })),
    /* 折り位置を縛っている業種だけ、md窓で字を1段落とす（<style> の `.has-keep` 参照） */
    hasKeep: Boolean(industry.hero.mainCatchKeep?.length),
    work: industry.cardWork,
    image: hasPublicAsset(file) ? `${base}/${file}` : null,
    alt: industry.hero.image.alt,
    width: size?.width,
    height: size?.height,
  };
});

/*
 * **段ごとに区切る**（2026-08-12）。埋まっている段は3列gridのまま、
 * 埋まらない最後の段だけを中央に寄せるため（司令塔判断）。
 * 段を分けずに1つのgridへ流すと端数が左端に寄り、flex1本に置き換えると
 * 列幅がcalcの丸めぶん（実測0.02px）ずれて、1024pxで文字の描画が微妙に動いた。
 * **埋まっている段は元の `repeat(3, 1fr)` を通す**のがいちばん確実。
 */
const COLUMNS = 3;
const rows = Array.from(
  { length: Math.ceil(cards.length / COLUMNS) },
  (_, r) => cards.slice(r * COLUMNS, r * COLUMNS + COLUMNS)
);
---

<section class="bg-white py-16 lg:py-24" id="industries">
  <div class="max-w-[1100px] mx-auto px-6 lg:px-8">
    <SectionHeading eyebrow={industryCards.eyebrow}>
      {industryCards.heading}
    </SectionHeading>

    {/* リード文は置かない（正本 §2）。見出しの直後にカード */}
    {rows.map((row, r) => (
      <div
        class:list={["ind-card-row", row.length < COLUMNS && "is-partial"]}
        style={`--card-count:${row.length}`}
      >
        {row.map((card, i) => (
        <div data-animate data-delay={(r * COLUMNS + i) * 120} class="h-full">
          {/* カード全体がリンク＝スマホは面のどこをタップしても遷移する */}
          <a href={card.href} class="ind-link-card">
            <span class="ind-link-visual">
              {card.image && (
                <img
                  src={card.image}
                  alt={card.alt}
                  width={card.width}
                  height={card.height}
                  loading="lazy"
                  decoding="async"
                />
              )}
              {/*
                ホバーで画像に薄い白をかけ、その上に業種名を浮かせる。
                下のテキストブロックに同じ業種名があるので、読み上げからは外す。
              */}
              <span class="ind-link-veil" aria-hidden="true">
                <span class="ind-link-veil-text">{card.name}</span>
              </span>
            </span>
            <span class="ind-link-body">
              <span class="ind-link-name">{card.name}</span>
              {/*
                一言は業種LPの改行位置をそのまま持ってくる（製造業だけ2行）。
                枠は2行ぶんの高さで固定してあるので、1行の業種が縮んで並びが崩れない。
              */}
              <span class:list={["ind-link-catch", card.hasKeep && "has-keep"]}>
                {card.catchLines.map((line) => (
                  <JaText tag="span" text={line.text} keep={line.keep} class="block" />
                ))}
              </span>
              <JaText tag="span" text={card.work} class="ind-link-work" />
            </span>
          </a>
        </div>
        ))}
      </div>
    ))}
  </div>
</section>

<style>
  /*
   * 3列の見た目は維持したまま、**埋まらない最後の段だけ中央に寄せる**（2026-08-12 司令塔判断）。
   *
   * 業種の上限は9本なので最終形は3×3でちょうど埋まるが、**4本目から8本目までの
   * すべての中間状態で必ず端数の段が出る**。1つのgridに流すと端数が左端に寄って右が空き、
   * 4列化すると最終9枚が 4+4+1 に崩れてカード自体も縮む。段ごとにコンテナを分ければ、
   * どの枚数でも「3列の段＋中央に寄った端数の段」で破綻しない。
   *
   * **埋まっている段は旧実装と同じ `repeat(3, 1fr)` を通す**のが要点。
   * 全体を1つのflexに置き換える案も試したが、列幅がcalcの丸めぶん0.02pxずれ、
   * 1024pxでキャッチ2行目の描画が微妙に動いた（画素比較で検出）。
   * 段を分ければ、埋まった段は式を使わないので**描画が完全に一致する**。
   */
  /*
   * 埋まっている段は**3列gridのまま**（旧実装の `grid-cols-1 md:grid-cols-3 gap-5 lg:gap-6
   * items-stretch` をそのままCSSに移しただけ）。カード幅・高さ・余白・ホバーは一切変えていない。
   */
  .ind-card-row {
    display: grid;
    grid-template-columns: 1fr;
    align-items: stretch;
    gap: 1.25rem; /* gap-5 */
  }

  /* 段と段のあいだも、段の中の余白と同じだけ空ける */
  .ind-card-row + .ind-card-row {
    margin-top: 1.25rem;
  }

  @media (min-width: 768px) {
    .ind-card-row {
      grid-template-columns: repeat(3, 1fr); /* md:grid-cols-3 */
    }

    /*
     * **埋まらない最後の段だけ中央に寄せる。**
     * 列を「3列だったときの1列ぶんの幅」で枚数ぶんだけ作り、トラックごと中央へ置く。
     * 1frのままだと端数の段でカードが伸びてしまうので、ここだけ幅を式で与える。
     */
    .ind-card-row.is-partial {
      grid-template-columns: repeat(var(--card-count), calc((100% - 1.25rem * 2) / 3));
      justify-content: center;
    }
  }

  @media (min-width: 1024px) {
    .ind-card-row {
      gap: 1.5rem; /* lg:gap-6 */
    }

    .ind-card-row + .ind-card-row {
      margin-top: 1.5rem;
    }

    .ind-card-row.is-partial {
      grid-template-columns: repeat(var(--card-count), calc((100% - 1.5rem * 2) / 3));
    }
  }

  /* 浮きカードの語彙は FeaturesSection と同じ（白地・1px罫線・上罫線3px・薄い影） */
  .ind-link-card {
    display: flex;
    flex-direction: column;
    height: 100%;
    background: #ffffff;
    border: 1px solid var(--color-line);
    border-top: 3px solid var(--color-ink);
    box-shadow: 0 6px 16px rgba(18, 18, 19, 0.06);
    transition:
      transform 0.3s ease,
      box-shadow 0.3s ease,
      border-top-color 0.3s ease;
  }

  /*
   * ホバーでふわっと浮く。**hoverできる装置だけ**に効かせる
   * （スマホでは :hover が「タップ後に残る」ので当てない）。
   */
  @media (hover: hover) {
    .ind-link-card:hover {
      transform: translateY(-4px);
      box-shadow: 0 14px 30px rgba(18, 18, 19, 0.14);
      border-top-color: var(--color-brand-orange);
    }
  }

  /* 動きを減らす設定の人には移動を出さない（浮きは影と罫線・膜で見せる） */
  @media (prefers-reduced-motion: reduce) {
    .ind-link-card {
      transition: box-shadow 0.3s ease, border-top-color 0.3s ease;
    }
    .ind-link-card:hover {
      transform: none;
    }
    .ind-link-veil-text {
      transform: none;
      transition: none;
    }
  }

  /* スマホはhoverが無いので、押した手応えは :active の軽い押し込みで返す */
  .ind-link-card:active {
    transform: translateY(1px);
    box-shadow: 0 3px 10px rgba(18, 18, 19, 0.08);
  }

  .ind-link-card:focus-visible {
    outline: 2px solid var(--color-brand-orange);
    outline-offset: 2px;
  }

  .ind-link-visual {
    position: relative;
    display: block;
    aspect-ratio: 3 / 2;
    overflow: hidden;
    background: var(--color-surface);
  }

  /*
   * ホバー時に画像へかける薄い膜と、その上に浮かぶ業種名（2026-08-06 なおき指示）。
   * 白い膜にしているのは、このLPが白地のモノクロ基調で、画像もすでに減彩してあるため。
   * 黒い膜だと明るい面の中に暗い矩形が1枚だけ立ち、浮くより先に目立ってしまう。
   * 文字は本文と同じ ink。72%の白の上なので、地の写真によらず読める。
   */
  .ind-link-veil {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(255, 255, 255, 0.72);
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.3s ease;
  }

  .ind-link-veil-text {
    font-size: 1.375rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    color: var(--color-ink);
    transform: translateY(8px);
    transition: transform 0.3s ease;
  }

  /* 膜と文字は**hoverできる装置だけ**に出す。タッチ端末では最初から出さない */
  @media (hover: hover) {
    .ind-link-card:hover .ind-link-veil {
      opacity: 1;
    }

    .ind-link-card:hover .ind-link-veil-text {
      transform: translateY(0);
    }
  }

  .ind-link-visual img {
    width: 100%;
    height: 100%;
    /* 被写体は素の画像の左側。右の余白側を切り落とす */
    object-fit: cover;
    object-position: left center;
    /* なじませはセクション画像と同値（design-manual §8-4） */
    filter: saturate(0.55) contrast(0.96) brightness(1.02);
    opacity: 0.92;
  }

  .ind-link-body {
    display: flex;
    flex-direction: column;
    flex: 1;
    padding: 1.5rem;
  }

  .ind-link-name {
    display: block;
    font-size: 0.8125rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    color: var(--color-mute);
    margin-bottom: 0.6rem;
  }

  /*
   * 一言。**2行ぶんの高さで固定**する（正本 §4）。
   * 製造業だけ2行・他は1行なので、固定しないとカードごとに対象業務の行の高さが変わる。
   */
  .ind-link-catch {
    display: block;
    font-size: 1.0625rem;
    font-weight: 700;
    line-height: 1.6;
    color: var(--color-ink);
    /* 2行ぶんの高さは font-size に追随させる（下のmd窓で字を落としても枠がずれない） */
    min-height: calc(1em * 1.6 * 2);
    margin-bottom: 0.6rem;
  }

  /*
   * **md窓（768〜1023px）だけ字を1段落とす。折り位置を縛っている業種のカードにだけ効かせる**
   * （2026-08-12）。
   *
   * ここは3列の中でカードがいちばん細く、一言の入る幅が実測 **176.7px**（768px時）しかない。
   * 運送の `次の依頼につながる` は9字＝17px・字間0.12emで **171.4px**（実測）必要で、
   * **余裕が5.3pxしかない**。16px・字間0.05emなら151.2pxで、余裕は25.5pxになる。
   *
   * **5pxで運用しないのは、はみ出したときの壊れ方が「分割不可の語が割れる」だから**
   * （正本 §1の禁止事項に直撃する）。字を1段落とすほうが軽い。
   * 2026-08-12 v3でキャッチが読点なしの明示2行になり、最長の塊は10字→9字に縮んだが、
   * **17pxに戻すほどの余裕は生まれていない**（旧: 10字で187.8px必要・11px不足で実際に割れていた）。
   *
   * **`.has-keep` に限定するのは、既存3業種のカードを1pxも動かさないため。**
   * 縛っていない業種の一言は budoux が文節で折るので、md窓で字を落とす理由が無い。
   * **1024px以上は縛っている業種でも変えない**（そちらは幅246pxで元から余っている）。
   *
   * 副作用として、md窓では**運送のカードだけ一言が16px**になる（他は17px）。
   * 4枚のときは運送が単独の段に入るので横並びの比較は起きないが、
   * **段の中に縛っている業種と縛っていない業種が並ぶ枚数になったら、ここは見直す**。
   */
  @media (min-width: 768px) and (max-width: 1023px) {
    .ind-link-catch.has-keep {
      font-size: 1rem;
      letter-spacing: 0.05em;
    }
  }

  .ind-link-work {
    display: block;
    font-size: 0.8125rem;
    line-height: 1.8;
    color: var(--color-mute);
  }

  @media (min-width: 1024px) {
    .ind-link-body {
      padding: 1.75rem;
    }
  }
</style>
