---
import JaText from "./ui/JaText.astro";
import { footer } from "../data/content";

interface Props {
  /**
   * 「完全成果報酬のため、初期費用はかかりません。」を出すか。
   * 既定 true＝トップLP・既存ページは従来どおり。
   * 業種LPは false にする（価格を一切書かない設計で、FAQの
   * 「金額を一律に掲載していません。価格・進め方は無料相談で」と矛盾するため）。
   */
  showRewardNote?: boolean;
  /**
   * サービス欄に5件目「AI顧問」（外部LP）を出すか。
   * **既定 false＝トップLP以外は従来どおり4件のまま。**
   * このFooterは業種LP6本と download/privacy/reserve/tokushoho からも読まれているので、
   * `footer.services` に直接足すと全ページに波及する。出し先を選べる形にしてある。
   */
  showAdvisorLink?: boolean;
}

const { showRewardNote = true, showAdvisorLink = false } = Astro.props;

// base path を含めたページリンク（Astro の base 設定に追従）
const base = import.meta.env.BASE_URL.replace(/\/$/, "");

/*
 * サービス欄の項目。**リストの中身を先に組んでから1回だけ描く。**
 * テンプレート側に `{showAdvisorLink && (...)}` を置くと、条件が false のときも
 * 式のぶんの空白が `</li>` と `</ul>` の間に残り、**業種LPのHTMLが2バイト変わる**
 * （実測。表示には影響しないが、「フッターは1バイトも変えていない」と言い切れなくなる）。
 * ここで配列にしておけば、5件目が無いときの出力は従来と完全に同一になる。
 */
const serviceLinks: { label: string; href: string; external: boolean }[] = [
  ...footer.services.map((label) => ({ label, href: `${base}/#services`, external: false })),
  ...(showAdvisorLink
    ? [{ label: footer.advisorService.label, href: footer.advisorService.href, external: true }]
    : []),
];
---

<footer class="bg-gradient-footer pt-16 pb-8" id="footer">
  <div class="max-w-[1100px] mx-auto px-6">
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-8 lg:gap-8 mb-12">
      <!-- Services -->
      <div>
        <h4 class="font-display text-white text-sm font-bold tracking-[0.12em] uppercase mb-4">
          サービス
        </h4>
        <ul class="space-y-2.5">
          {serviceLinks.map((service) => (
            <li>
              {service.external ? (
                /* 外部LPへ飛ぶ項目は、関連リンク欄と同じ作法（新しいタブ＋外部アイコン） */
                <a
                  href={service.href}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="text-white/50 text-sm hover:text-white transition-colors inline-flex items-center gap-1 py-1.5"
                >
                  {service.label}
                  <svg class="w-3.5 h-3.5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 6H5.25A2.25 2.25 0 003 8.25v10.5A2.25 2.25 0 005.25 21h10.5A2.25 2.25 0 0018 18.75V10.5m-10.5 6L21 3m0 0h-5.25M21 3v5.25" />
                  </svg>
                </a>
              ) : (
                <a href={service.href} class="text-white/50 text-sm hover:text-white transition-colors block py-1.5">
                  {service.label}
                </a>
              )}
            </li>
          ))}
        </ul>
      </div>

      <!-- Company -->
      <div>
        <h4 class="font-display text-white text-sm font-bold tracking-[0.12em] uppercase mb-4">
          企業情報
        </h4>
        <ul class="space-y-2.5">
          {footer.company.map((item) => (
            <li>
              <a href={`${base}/${item.slug}`} class="text-white/50 text-sm hover:text-white transition-colors block py-1.5">
                {item.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Links -->
      <div>
        <h4 class="font-display text-white text-sm font-bold tracking-[0.12em] uppercase mb-4">
          関連リンク
        </h4>
        <ul class="space-y-2.5">
          <li>
            <a
              href={footer.social.salon}
              target="_blank"
              rel="noopener noreferrer"
              class="text-white/50 text-sm hover:text-white transition-colors inline-flex items-center gap-1"
            >
              オンラインサロン「アイサロ」
              <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 6H5.25A2.25 2.25 0 003 8.25v10.5A2.25 2.25 0 005.25 21h10.5A2.25 2.25 0 0018 18.75V10.5m-10.5 6L21 3m0 0h-5.25M21 3v5.25" />
              </svg>
            </a>
          </li>
        </ul>
      </div>

      <!-- SNS -->
      <div>
        <h4 class="font-display text-white text-sm font-bold tracking-[0.12em] uppercase mb-4">
          SNS
        </h4>
        <a
          href={footer.social.x}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 text-white/50 text-sm hover:text-white transition-colors py-3"
        >
          <svg class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor">
            <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z" />
          </svg>
          @Sokichi_Hoshino
        </a>
      </div>
    </div>

    <!-- Company info -->
    <div class="border-t border-white/10 pt-8 mb-8">
      <dl class="grid grid-cols-1 gap-y-2 max-w-[760px] text-[15px]">
        <div class="flex gap-3">
          <dt class="text-white shrink-0 w-20">運営</dt>
          <dd class="text-white">{footer.companyInfo.name}</dd>
        </div>
        <div class="flex gap-3">
          <dt class="text-white shrink-0 w-20">代表者</dt>
          <dd class="text-white">{footer.companyInfo.rep}</dd>
        </div>
        <div class="flex gap-3">
          <dt class="text-white shrink-0 w-20">所在地</dt>
          <dd class="text-white">{footer.companyInfo.address}</dd>
        </div>
        <div class="flex gap-3">
          <dt class="text-white shrink-0 w-20">電話番号</dt>
          <dd class="text-white">{footer.companyInfo.tel}</dd>
        </div>
        <div class="flex gap-3">
          <dt class="text-white shrink-0 w-20">メール</dt>
          <dd class="text-white">{footer.companyInfo.email}</dd>
        </div>
      </dl>
      {showRewardNote && (
        <JaText tag="p" text={footer.note} class="text-white text-[15px] mt-5 leading-relaxed" />
      )}
    </div>

    <!-- Bottom bar -->
    <div class="border-t border-white/10 pt-6">
      <p class="text-white/30 text-[15px] text-center">
        {footer.copyright}
      </p>
    </div>
  </div>
</footer>
