---
/**
 * 業種LPのファーストビュー。
 * PC: コピー=左／画像=右（既存トップLPの構造）。素の画像は「被写体=左／余白=右」なので
 *     CSSで左右反転して被写体を右へ送る（design-manual.md 4-2）。
 * SP: 画像を見出しの背後に敷き、コピーを上に重ねる（トップLPの `.hero-video-mobile` と同じ構造）。
 *     可読性は白かぶせ（design-manual.md 4-3 の `.hero-overlay` 系）で担保する。
 *
 * v2で削除: 英語ラベル / 日本語バッジ / カテゴリ表記 / 提供範囲ラベル
 * （tone-manner.md §9。業種別LPでは使わない）。
 */
import Button from "../ui/Button.astro";
import JaText from "../ui/JaText.astro";
import CopyBlock from "./CopyBlock.astro";
import { hasPublicAsset, webpSize } from "../../lib/publicAsset";
import {
  ctaUrl,
  mainCatchKeepFor,
  mainCatchKeepLength,
  type IndustryHero,
} from "../../data/industries";

interface Props {
  hero: IndustryHero;
  ctaVersion: string;
}

const { hero, ctaVersion } = Astro.props;

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
/*
 * ヒーロー画像も SectionImage と同じく**ビルド時に実在を見る**。
 * 無ければ画像を描かない＝画像の生成を待たずにコピーとレイアウトを先に仕上げられる
 * （旧実装は無条件に <img> を出していたので、未着の業種でリンク切れ画像が出ていた）。
 * 実寸も画像から読む。**業種ごとに比率が違う**ので、決め打ちの width/height を書かない。
 */
const heroPath = `industry/${hero.image.file}`;
const hasHeroImage = hasPublicAsset(heroPath);
const heroSize = webpSize(heroPath);
const imageSrc = `${base}/${heroPath}`;
const reserveHref = ctaUrl(base, "reserve", "hero", ctaVersion);
const downloadHref = ctaUrl(base, "download", "hero", ctaVersion);
---

<section class="relative bg-white overflow-hidden" id="hero">
  {/*
    PC: 右側の画像（白地になじませる。コピーの背後まで回り込む）。
    画像と白かぶせは**コンテンツコンテナと同じ幅の土台**（.ind-hero-stage）の中に置く。
    ビューポート基準で右に置くと、広い画面ほど画像だけが右端へ流れてコピーとの間が空く。
  */}
  {hasHeroImage && (
    <div class="ind-hero-stage hidden lg:block" aria-hidden="true">
      <div class="ind-hero-visual">
        <img
          src={imageSrc}
          alt=""
          width={heroSize?.width}
          height={heroSize?.height}
          decoding="async"
          fetchpriority="high"
          class:list={["ind-hero-image", hero.image.flip && "is-flipped"]}
        />
      </div>
      <div class="ind-hero-overlay"></div>
    </div>
  )}

  {/*
    SP: 見出しの背後に敷く画像。PCの土台とは別レイヤーにして、**互いのCSSが干渉しないようにする**
    （PC側は `hidden lg:block`／こちらは `lg:hidden` で、どちらか一方しか描かれない）。
    トップLPの `.hero-video-mobile` と同じく、右へ寄せて上端をヘッダーの下に置き、
    コピー（`relative z-10`）をその上に重ねる。
  */}
  {hasHeroImage && (
    <div class="ind-hero-sp lg:hidden" aria-hidden="true">
      <img
        src={imageSrc}
        alt=""
        width={heroSize?.width}
        height={heroSize?.height}
        decoding="async"
        fetchpriority="high"
        class:list={[
          "ind-hero-image ind-hero-sp-image",
          hero.image.flip && "is-flipped",
        ]}
      />
      <div class="ind-hero-sp-overlay"></div>
    </div>
  )}

  <div
    class="relative z-10 max-w-[1260px] mx-auto px-6 lg:px-8 pt-24 pb-16 lg:pt-36 lg:pb-24"
  >
    <div class="max-w-[820px]">
      {/*
        改行位置は演出そのもの。1行=1ブロックで固定し、budouxに結合させない。
        `mainCatchKeep` を持つ業種は、**行の中で折ってよい位置も業種側が決める**
        （幅が足りたときは1行のまま＝行を割らずに折り位置だけ縛る）。
      */}
      <h1
        class:list={[
          "font-mincho leading-[1.45] tracking-[0.05em] font-bold text-ink mb-5",
          /* 折り位置を縛っている業種だけに、保護語が収まる上限を効かせる（下の <style> 参照） */
          hero.mainCatchKeep?.length && "has-keep",
        ]}
        style={`--catch-len:${mainCatchKeepLength(hero)}`}
        data-animate
      >
        {hero.mainCatch.map((line) => (
          <JaText
            tag="span"
            text={line}
            keep={mainCatchKeepFor(hero, line)}
            tightComma={hero.mainCatchTightComma}
            class="block"
          />
        ))}
      </h1>

      <JaText
        tag="p"
        text={hero.subCatch}
        class="text-ink font-bold text-lg sm:text-xl lg:text-2xl leading-snug mb-6"
        data-animate
        data-delay="60"
      />

      <div data-animate data-delay="100">
        <CopyBlock
          paragraphs={hero.subCopy}
          class="mb-9"
          lineClass="text-ink text-[15px] sm:text-[17px] leading-[1.95]"
        />
      </div>

      {/* 横並びは lg から。sm〜lg は2本並べると幅が足りず、ラベルが折れるか画面から溢れる */}
      <div
        class="flex flex-col lg:flex-row items-stretch lg:items-center gap-4 mb-5"
        data-animate
        data-delay="140"
      >
        <Button
          variant="primary"
          href={reserveHref}
          class="w-full lg:w-auto lg:whitespace-nowrap"
        >
          {hero.primaryCta}
        </Button>
        <Button
          variant="white"
          href={downloadHref}
          class="w-full lg:w-auto lg:whitespace-nowrap"
        >
          {hero.secondaryCta}
        </Button>
      </div>

      <div data-animate data-delay="180">
        {hero.microCopy.map((line) => (
          <JaText tag="p" text={line} class="text-mute text-[13px] leading-relaxed" />
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  /*
   * 画像と白かぶせの土台。**本文と同じ 1260px のコンテナに揃える**。
   * 2026-08-06 なおきレビュー: 1800px級の画面で画像がビューポート右端に張り付き、
   * コピーとの間に大きな余白ができていた（旧実装は left:50% + 幅880px のビューポート基準）。
   * 土台をコンテナ幅にすると、画面がどれだけ広くなってもコピーと画像の距離が変わらない。
   */
  .ind-hero-stage {
    position: absolute;
    top: 0;
    bottom: 0;
    left: 50%;
    width: 100%;
    max-width: 1260px;
    transform: translateX(-50%);
    z-index: 0;
    pointer-events: none;
  }

  /* PC: コンテナの右端に寄せた画像レイヤー */
  .ind-hero-visual {
    position: absolute;
    top: 50%;
    right: 0;
    width: min(760px, 60%);
    transform: translateY(-50%);
    pointer-events: none;
  }

  /*
   * 白地へのなじませ。減彩・multiply・opacity は design-manual.md 4-1 の採用値のまま。
   *
   * maskだけ規定の radial（ellipse 86% 86% at 56% 50%, #000 54%, transparent 94%）から変えている。
   * 規定値は 16:9 の写真に当てると端が alpha 0.72〜0.90 までしか落ちず、
   * 「端をぼかして矩形の輪郭を殺す」という規定の目的が達成できなかった（実測）。
   * 代わりに縦横の linear で端を確実に0まで落とす。全業種で同一の値＝業種ごとに変えないことは維持。
   *
   * maskは画像のローカル座標に効くので、反転の有無にかかわらず値は同じでよい
   * （余白は常にローカル右38%。そこを落とすとコピー側が白に抜ける）。
   */
  .ind-hero-image {
    display: block;
    width: 100%;
    height: auto;
    filter: saturate(0.55) contrast(0.94) brightness(1.03);
    mix-blend-mode: multiply;
    opacity: 0.85;
    -webkit-mask-image:
      linear-gradient(90deg, transparent 0%, #000 8%, #000 70%, transparent 100%),
      linear-gradient(180deg, transparent 0%, #000 12%, #000 88%, transparent 100%);
    mask-image:
      linear-gradient(90deg, transparent 0%, #000 8%, #000 70%, transparent 100%),
      linear-gradient(180deg, transparent 0%, #000 12%, #000 88%, transparent 100%);
    -webkit-mask-composite: source-in;
    mask-composite: intersect;
    pointer-events: none;
  }

  /* 左右反転して被写体を右へ送る（design-manual.md 4-2） */
  .ind-hero-image.is-flipped {
    transform: scaleX(-1);
  }

  /*
   * 左（コピー側）を白く残して可読性を確保（既存 .hero-overlay と同値）。
   * 土台と同じ幅なので、**画像と同じ座標系でかぶさる**（旧実装はビューポート幅だったため、
   * 広い画面では白の切れる位置と画像の位置がずれていた）。
   */
  .ind-hero-overlay {
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    background: linear-gradient(
      90deg,
      #ffffff 28%,
      rgba(255, 255, 255, 0.55) 55%,
      rgba(255, 255, 255, 0) 100%
    );
  }

  /*
   * h1の大きさの正本はここ1箇所（旧: Tailwindの `text-[clamp(...)]` クラス）。
   * **下の `.has-keep` の上限式が同じ値を参照するので、2箇所に書かない。**
   * 式は従来と同一なので、**保護語を持たない業種の描画は1pxも変わらない**。
   */
  h1 {
    --catch-size: clamp(1.85rem, 3.1vw + 0.8rem, 2.9rem);
    font-size: var(--catch-size);
  }

  /*
   * **保護語（`mainCatchKeep`）が版面に収まる大きさまで、字を自動で抑える**（2026-08-13）。
   *
   * 保護語は幅が足りなくても割ってはいけないが、`overflow-wrap: anywhere` は
   * **入りきらなければ任意位置で折る**。つまり**最後の防波堤は「幅に入る大きさか」**で、
   * ここを外すと `来月の入庫予定に変わ／る` のような割れ方が出る（自動車整備で実際に出た）。
   *
   * 上限＝**版面の幅 ÷ 保護語の字数**。`--catch-len` は業種のデータから渡る（半角は0.5字）。
   * `1.05` は字間0.05emぶん、`3.5rem` は左右パディング48pxに8pxの安全代を足した値。
   *
   * **業種ごとにブレークポイントと固定値を調整する方式はやめた**（旧: `@media (max-width:359px)`
   * で1.55rem）。保護語の長さは業種ごとに違い（運送5字・自動車整備11字）、
   * **固定値はそのとき実装した業種の字数にしか合わない**——実際、運送に合わせた1.55remでは
   * 自動車整備の11字に足りず、320/360/375pxで保護語が割れた。
   * 式にしておけば**新しい業種を足しても自動で追随する**。
   *
   * 上限が効くのは狭い幅だけで、**広い画面では clamp 側が必ず小さいので何も起きない**
   * （1440pxなら上限119px・clamp 46.4px）。
   */
  h1.has-keep {
    font-size: min(
      var(--catch-size),
      calc((100vw - 3.5rem) / (var(--catch-len) * 1.05))
    );
  }

  /*
   * **360px未満は基準の字も1段落とす**（2026-08-12 運送で導入。`.has-keep` 限定）。
   *
   * 上の上限式が守るのは**保護語**だが、キャッチには**保護語に入っていないのに
   * 割ってはいけない塊**があることがある。運送の前半 `見積回答も請求書も、` がそれで、
   * 正本が「折れるのは読点の後で1回だけ」と定めている一方、`mainCatchKeep` には
   * 後半 `AIで自動化` しか入っていない（前半はbudouxが `見積回答も／請求書も、` で折れてしまう）。
   * 320px幅では10字＝310.8pxに対し版面272pxで、**この1段の引き下げが前半を1行に保っている**。
   *
   * **つまりこの規則は運送の前半を守るために残っている。** 保護語の上限式とは目的が別なので、
   * 片方だけ見て消さないこと。**運送のキャッチを差し替えるときは、
   * 前半も `mainCatchKeep` に入れて上限式へ寄せるほうが安全**（そうすれば固定値に依存しなくなる）。
   */
  @media (max-width: 359px) {
    h1.has-keep {
      --catch-size: 1.55rem;
    }
  }

  /*
   * ===== SP（lg未満）: 画像を背景にしてコピーを重ねる =====
   * ここから下は **すべて max-width:1023px の中**にある。lg以上の出力は1pxも動かさない。
   */
  @media (max-width: 1023px) {
    .ind-hero-sp {
      position: absolute;
      inset: 0;
      z-index: 0;
      overflow: hidden;
      pointer-events: none;
    }

    /*
     * 上端はヘッダー（h-20=80px）の直下に置く。ヘッダーは bg-white/90 の半透明なので、
     * 画像を潜り込ませると帯の中で像が透けて見える。
     * 右へ 8% はみ出させて矩形の右辺を画面外へ逃がす（トップLPの `right:-2%` と同じ考え方）。
     */
    .ind-hero-sp-image {
      position: absolute;
      top: 84px;
      right: -8%;
      width: 112%;
      /*
       * Tailwindのpreflightが `img { max-width: 100% }` を当てるので、これが無いと
       * 112%が100%に丸められ、**左辺が画面内（x=+31px）に残って縦の継ぎ目になる**（実測）。
       */
      max-width: none;
      height: auto;
      opacity: 0.72;
      /*
       * SPは像の上に本文が乗るので、ヒーロー既定（0.85）より沈める。
       *
       * maskは**縦1本のlinear**にする。左右の辺は上の `right:-8% / width:112%` で
       * 常に画面の外（左-4%・右+8%）にあり、見えるのは上辺と下辺だけだから。
       * PC既定の radial や横linearをここへ当てると、画面内に入っていない左右を削るだけで
       * 肝心の下辺が alpha 0.7 のまま残り、**本文の手前に横一直線の切れ目が出る**（実測）。
       *   - 上辺: ヘッダー直下で 0 から立ち上げる
       *   - 下辺: 画像の下端で完全に 0。サブキャッチの下＝本文が始まる手前で像が消える
       */
      -webkit-mask-image: linear-gradient(
        180deg,
        transparent 0%,
        #000 16%,
        #000 58%,
        transparent 100%
      );
      mask-image: linear-gradient(
        180deg,
        transparent 0%,
        #000 16%,
        #000 58%,
        transparent 100%
      );
      -webkit-mask-composite: source-over;
      mask-composite: add;
    }

    /*
     * 白かぶせ（design-manual.md 4-3）。SPはコピーが画像の全幅に乗るので、
     * PCの横1本のグラデーションでは足りない。**縦と横の2枚を重ねる**:
     *   - 縦 = 本文とCTAが始まる高さから下を完全な白に戻す（読む文章は素の白地に置く）
     *   - 横 = 行頭側（左）を厚く、被写体のいる右を薄くして像を残す
     * 合成の不透明度は 1-(1-a縦)(1-a横)。h1の帯で 0.55〜0.78 になり、
     * 実測の背景輝度は最小 0.62（コントラスト 11.9:1）まで持ち上がる。
     */
    .ind-hero-sp-overlay {
      position: absolute;
      inset: 0;
      z-index: 1;
      pointer-events: none;
      background:
        linear-gradient(
          180deg,
          rgba(255, 255, 255, 0.36) 0%,
          rgba(255, 255, 255, 0.36) 34%,
          rgba(255, 255, 255, 0.86) 62%,
          #ffffff 74%
        ),
        linear-gradient(
          90deg,
          rgba(255, 255, 255, 0.66) 0%,
          rgba(255, 255, 255, 0.42) 52%,
          rgba(255, 255, 255, 0.3) 100%
        );
    }
  }
</style>
