---
/**
 * 5. AIがやること、人が決めること。
 * 処理表は PC=2列テーブル（工程列は中央寄せ・内容列は左寄せ）／SP=縦フロー（矢印区切り）。
 * 横スクロールはさせない。写真は入れない（表が視覚要素なので、視線の行き先を2つにしない）。
 */
import SectionHeading from "../ui/SectionHeading.astro";
import JaText from "../ui/JaText.astro";
import EmText from "./EmText.astro";
import type { IndustryTransparency } from "../../data/industries";

interface Props {
  data: IndustryTransparency;
}

const { data } = Astro.props;
---

<section class="bg-white py-16 lg:py-24" id="how-it-works">
  <div class="max-w-[1100px] mx-auto px-6 lg:px-8">
    <SectionHeading>
      {data.heading.map((line) => <JaText tag="span" text={line} class="block" />)}
    </SectionHeading>

    <div class="ind-lead max-w-[940px] mb-10" data-animate>
      {data.lead.map((line) => (
        <EmText
          tag="p"
          text={line}
          emphasis={data.emphasis}
          class="text-ink font-bold text-[17px] sm:text-[19px] leading-[1.85]"
        />
      ))}
    </div>

    <!-- 処理表 -->
    <div class="ind-flow max-w-[940px]" data-animate>
      <div class="ind-flow-head">
        <span>{data.flowHeader[0]}</span>
        <span>{data.flowHeader[1]}</span>
      </div>
      {data.flow.map((row, i) => (
        <>
          {i > 0 && (
            <div class="ind-flow-arrow lg:hidden" aria-hidden="true">↓</div>
          )}
          <div class="ind-flow-row">
            <div class="ind-flow-label">{row.label}</div>
            <div class="ind-flow-body">
              <JaText
                tag="p"
                text={row.body}
                class="text-ink text-[15px] sm:text-base leading-[1.9]"
              />
            </div>
          </div>
        </>
      ))}
    </div>

    <!-- 表の下 -->
    <div class="max-w-[940px] mt-8 bg-ink text-white p-6 lg:p-8" data-animate>
      {data.emphasisBlock.map((line) => (
        <JaText
          tag="p"
          text={line}
          class="text-white text-[15px] sm:text-base font-bold leading-[1.9]"
        />
      ))}
    </div>

    <div class="max-w-[860px] mt-10" data-animate>
      {data.closing.map((line) => (
        <JaText
          tag="p"
          text={line}
          class="text-ink text-[15px] sm:text-base leading-[1.95]"
        />
      ))}
    </div>
  </div>
</section>

<style>
  /*
   * リードは1行が長く、素のままだと2行目に数文字だけ残って不自然に見える。
   * 行を均す（text-wrap: balance）ことで、折り返しても意味の切れ目で2行に割れる。
   * 幅も下の処理表と同じ940pxに揃えてある。
   */
  .ind-lead :global(p) {
    text-wrap: balance;
  }

  /* SP: 縦に積んだ工程カード。PC: 2列テーブル */
  .ind-flow-head {
    display: none;
  }

  .ind-flow-row {
    background: #ffffff;
    border: 1px solid var(--color-line);
    padding: 1rem 1.25rem;
  }

  .ind-flow-label {
    display: block;
    font-weight: 700;
    color: var(--color-ink);
    letter-spacing: 0.08em;
    margin-bottom: 0.5rem;
  }

  .ind-flow-arrow {
    text-align: center;
    color: var(--color-mute);
    line-height: 1;
    padding: 0.5rem 0;
  }

  @media (min-width: 1024px) {
    .ind-flow {
      border: 1px solid var(--color-line);
      background: #ffffff;
    }

    .ind-flow-head {
      display: grid;
      grid-template-columns: 220px 1fr;
      background: var(--color-ink);
      color: #ffffff;
      font-weight: 700;
      letter-spacing: 0.1em;
    }

    /*
     * 見出し行は2つとも中央寄せ（2026-08-06 なおきレビュー。
     * 「工程」だけ中央で「内容」が左だと、同じ黒帯の中で揃っていないように見える）。
     * **本文セルは「工程」列だけ中央・「内容」列は左寄せのまま**（読む文章なので左が正）。
     */
    .ind-flow-head span {
      padding: 1rem 1.5rem;
      text-align: center;
    }

    .ind-flow-head span + span {
      border-left: 1px solid rgba(255, 255, 255, 0.15);
    }

    .ind-flow-row {
      display: grid;
      grid-template-columns: 220px 1fr;
      border: 0;
      border-top: 1px solid var(--color-line);
      padding: 0;
    }

    /* 見出し行の直後だけ罫線を消す（:first-of-type は要素型で効くのでここでは使えない） */
    .ind-flow-head + .ind-flow-row {
      border-top: 0;
    }

    .ind-flow-label {
      margin: 0;
      padding: 1.25rem 1.5rem;
      background: var(--color-surface);
      text-align: center;
    }

    .ind-flow-body {
      padding: 1.25rem 1.5rem;
      border-left: 1px solid var(--color-line);
    }
  }
</style>
