---
/**
 * 3. なぜ今か。画像は左。
 * 統計の出典注記は本文と同じ幅・text-xs で必ず出す（数値の帰属を誤読させないため。削らない）。
 */
import SectionHeading from "../ui/SectionHeading.astro";
import JaText from "../ui/JaText.astro";
import EmText from "./EmText.astro";
import CopyBlock from "./CopyBlock.astro";
import SectionSplit from "./SectionSplit.astro";
import type { IndustryEducation } from "../../data/industries";

interface Props {
  data: IndustryEducation;
}

const { data } = Astro.props;
---

<section class="bg-white py-16 lg:py-24" id="why-now">
  <div class="max-w-[1100px] mx-auto px-6 lg:px-8">
    <SectionHeading>
      {data.heading.map((line) => <JaText tag="span" text={line} class="block" />)}
    </SectionHeading>

    <SectionSplit image={data.image}>
      <div data-animate>
        <CopyBlock
          paragraphs={data.body}
          lineClass="text-ink text-[15px] sm:text-base leading-[1.95]"
        />
      </div>
    </SectionSplit>

    <div class="max-w-[880px] mt-12 border-l-4 border-ink pl-6 sm:pl-8" data-animate>
      <h3 class="text-ink font-bold text-lg sm:text-xl lg:text-2xl leading-[1.6] mb-4">
        {data.subHeading.map((line) => (
          <EmText tag="span" text={line} emphasis={data.emphasis} class="block" />
        ))}
      </h3>
      {/*
        **教育の核にも強調を効かせる**（2026-08-14）。
        旧実装は小見出しにしか `emphasis` を渡しておらず、**強調語が小見出しにある業種しか
        描画できなかった**。印刷v2は小見出しの文言がFVへ昇格したため、正本の強調語
        （`削った時間を誰のどの活動に戻すか`）が本文側に移り、そのまま黙って効かなくなっていた
        （検品で「強調の数 5」＝他業種の6に足りず発覚）。

        **既存5業種の描画は1文字も変わらない**——5業種とも強調語は小見出しにあり、
        **本文には1つも含まれない**ことを実データで確認済み（マッチしないので `EmText` は
        素通しになる）。他セクション（悩み・解決策・FAQ・最終CTA）は元から本文へ渡しており、
        **ここだけが渡していなかった**ので、実装の抜けを揃えた形。
      */}
      <CopyBlock
        paragraphs={data.subBody}
        emphasis={data.emphasis}
        lineClass="text-ink text-[15px] sm:text-base leading-[1.95]"
      />
    </div>

    <div class="max-w-[880px] mt-10" data-animate>
      <JaText tag="p" text={data.note} class="text-mute text-xs leading-[1.9]" />
    </div>
  </div>
</section>
