---
/** 9. 中間CTA。計測は cta=flow */
import SectionHeading from "../ui/SectionHeading.astro";
import Button from "../ui/Button.astro";
import JaText from "../ui/JaText.astro";
import { ctaUrl, type IndustryMidCta } from "../../data/industries";

interface Props {
  data: IndustryMidCta;
  ctaVersion: string;
}

const { data, ctaVersion } = Astro.props;

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const reserveHref = ctaUrl(base, "reserve", "flow", ctaVersion);
const downloadHref = ctaUrl(base, "download", "flow", ctaVersion);
---

<section class="bg-white py-16 lg:py-24" id="free-consult">
  <div class="max-w-[1100px] mx-auto px-6 lg:px-8">
    <div class="border-2 border-ink p-6 sm:p-10 lg:p-14">
      <SectionHeading>
        {data.heading.map((line) => <JaText tag="span" text={line} class="block" />)}
      </SectionHeading>

      <div class="max-w-[820px]" data-animate>
        {data.body.map((line) => (
          <JaText
            tag="p"
            text={line}
            class="text-ink text-[15px] sm:text-base leading-[1.95]"
          />
        ))}
      </div>

      <div
        class="flex flex-col lg:flex-row items-stretch lg:items-center lg:justify-center gap-4 mt-10 mb-5"
        data-animate
      >
        <Button variant="primary" href={reserveHref} class="w-full lg:w-auto lg:whitespace-nowrap">
          {data.primaryCta}
        </Button>
        <Button variant="white" href={downloadHref} class="w-full lg:w-auto lg:whitespace-nowrap">
          {data.secondaryCta}
        </Button>
      </div>

      <div data-animate>
        {data.microCopy.map((line) => (
          <JaText tag="p" text={line} class="text-mute text-[13px] leading-relaxed" />
        ))}
      </div>
    </div>
  </div>
</section>
