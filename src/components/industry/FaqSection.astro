---
/**
 * 10. よくある質問。
 * トグル（アコーディオン）形式・カードごと・中央配置（レビュー指摘 E-5）。
 * ネイティブの <details>/<summary> で作るのでJSゼロ。キーボード操作にも標準で対応する。
 */
import SectionHeading from "../ui/SectionHeading.astro";
import JaText from "../ui/JaText.astro";
import EmText from "./EmText.astro";
import type { IndustryFaq } from "../../data/industries";

interface Props {
  data: IndustryFaq;
}

const { data } = Astro.props;
---

<section class="bg-surface py-16 lg:py-24" id="faq">
  <div class="max-w-[1100px] mx-auto px-6 lg:px-8">
    <SectionHeading align="center">
      {data.heading.map((line) => <JaText tag="span" text={line} class="block" />)}
    </SectionHeading>

    <div class="max-w-[820px] mx-auto">
      {data.items.map((item, i) => (
        <details class="ind-faq bg-white border border-line mb-3" data-animate data-delay={i * 50}>
          <summary class="ind-faq-summary">
            <span class="flex items-start gap-3 pr-4">
              <span class="font-display text-ink font-bold shrink-0">Q.</span>
              <JaText
                tag="span"
                text={item.q}
                class="text-ink font-bold text-[15px] lg:text-[17px] leading-[1.7]"
              />
            </span>
            <svg
              class="ind-faq-chevron shrink-0"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              aria-hidden="true"
            >
              <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
            </svg>
          </summary>
          <div class="px-5 lg:px-7 pb-5 lg:pb-6">
            <div class="flex items-start gap-3 pt-4 border-t border-line">
              <span class="font-display text-mute font-bold shrink-0">A.</span>
              <div>
                {item.a.map((line) => (
                  <EmText
                    tag="p"
                    text={line}
                    emphasis={data.emphasis}
                    class="text-ink text-[15px] leading-[1.9]"
                  />
                ))}
              </div>
            </div>
          </div>
        </details>
      ))}
    </div>
  </div>
</section>

<style>
  .ind-faq-summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    padding: 1.15rem 1.25rem;
    cursor: pointer;
    list-style: none;
    transition: background-color 0.2s ease;
  }

  /* 既定の三角マーカーを消す */
  .ind-faq-summary::-webkit-details-marker {
    display: none;
  }

  .ind-faq-summary::marker {
    content: "";
  }

  .ind-faq-summary:hover {
    background: var(--color-surface);
  }

  .ind-faq-summary:focus-visible {
    outline: 2px solid var(--color-ink);
    outline-offset: -2px;
  }

  .ind-faq-chevron {
    width: 20px;
    height: 20px;
    color: var(--color-mute);
    transition: transform 0.25s ease;
  }

  .ind-faq[open] .ind-faq-chevron {
    transform: rotate(180deg);
  }

  @media (min-width: 1024px) {
    .ind-faq-summary {
      padding: 1.35rem 1.75rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .ind-faq-chevron {
      transition: none;
    }
  }
</style>
