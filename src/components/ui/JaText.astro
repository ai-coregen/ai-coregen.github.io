---
/**
 * Japanese text with natural phrase-boundary line breaks.
 * Uses Google's budoux to insert <wbr> at phrase boundaries.
 * Combined with word-break: keep-all, text only breaks at natural points.
 * Works on ALL browsers (Safari, Chrome, Firefox).
 *
 * `keep` に語句を渡すと、**その語句の内側には改行位置を作らない**（budouxの `<wbr>` を落として
 * 前後のチャンクを1つに繋ぐ）。キャッチのように**折り位置そのものが演出**で、文節単位の
 * 自動折り返しでは割れてほしくない箇所に使う。
 * 例: 運送の `次の依頼につながる` は因果の着地点なので、`次の／依頼につながる` と割れてはいけない。
 */
import { loadDefaultJapaneseParser } from "budoux";

interface Props {
  text: string;
  /**
   * 途中で折ってはいけない語句。`text` に**そのままの表記で含まれていること**が条件で、
   * 見つからなければビルドを止める（黙って効かないと、崩れた折り返しが本番に出るため）。
   */
  keep?: string[];
  /**
   * 読点（`、`）を**約物半角**で組む。読点は全角枠の左半分にしか字面が無いので、
   * 既定のままだと右に半角ぶんの空きが残る。それを `margin-right: -0.5em` で詰める。
   *
   * **行末に読点が来たときの「宙に浮く」見え方を半分にする**のが目的（2026-08-12 なおきFB）。
   * 1行に収まっているときは、和文の標準的な約物詰めとして自然に見える。
   * **既定はオフ**＝渡さなければ従来と同じ組版になる。
   */
  tightComma?: boolean;
  class?: string;
  tag?: "p" | "span" | "h1" | "h2" | "h3" | "h4" | "li";
  [key: string]: any;
}

const {
  text,
  keep = [],
  tightComma = false,
  class: className = "",
  tag: Tag = "p",
  ...attrs
} = Astro.props;

const parser = loadDefaultJapaneseParser();
const chunks = parser.parse(text);

/**
 * `keep` の語句の内側に落ちる改行位置を潰して、残った位置だけを `<wbr>` にする。
 *
 * budouxのチャンク境界は文字位置で表せるので、**語句が占める範囲の内側の境界だけ**を
 * 禁止集合に入れ、禁止された境界でチャンクを連結する。語句が文節の途中から始まっていても
 * （`次の依頼に` のように文節をまたいでいても）、境界の位置だけで判定できるので影響を受けない。
 */
function applyKeep(parts: string[], phrases: string[]): string[] {
  if (phrases.length === 0) return parts;

  const blocked = new Set<number>();
  for (const phrase of phrases) {
    let from = text.indexOf(phrase);
    if (from === -1) {
      throw new Error(
        `JaText: keep に渡した「${phrase}」が text「${text}」に含まれていません。` +
          `表記が1文字でも違うと折り位置の固定が効かないので、正本の表記に揃えてください。`
      );
    }
    while (from !== -1) {
      /* 語句の内側＝開始位置より後・終了位置より前の境界だけを禁止する */
      for (let i = from + 1; i < from + phrase.length; i++) blocked.add(i);
      from = text.indexOf(phrase, from + 1);
    }
  }

  const merged: string[] = [];
  let at = 0;
  for (const part of parts) {
    if (at > 0 && blocked.has(at)) merged[merged.length - 1] += part;
    else merged.push(part);
    at += part.length;
  }
  return merged;
}

const segments = applyKeep(chunks, keep);

/**
 * `tightComma` のとき、読点だけを `<span>` に切り出すために区切る。
 * 読点を含まない文字列は1要素のまま返るので、**オフのときと同じ描画**になる。
 */
function splitComma(segment: string): string[] {
  return tightComma ? segment.split(/(、)/).filter(Boolean) : [segment];
}
---

<Tag class:list={["break-keep", className]} {...attrs}>
  {segments.map((segment, i) => (
    <>
      {i > 0 && <wbr />}
      {splitComma(segment).map((piece) =>
        piece === "、" ? <span class="ja-tight-comma">{piece}</span> : piece
      )}
    </>
  ))}
</Tag>

<style>
  .break-keep {
    word-break: keep-all;
    /* はみ出す場合のみ任意位置で改行（min-content も縮みブローアウト防止）。
       通常は budoux の <wbr> による文節改行が優先される */
    overflow-wrap: anywhere;
  }

  /*
   * 約物半角。読点は全角枠の**左半分にしか字面が無い**ので、右の半角ぶんを詰める。
   *
   * - 1行に収まっているとき: 読点と次の字の間隔が和文の標準的な詰めになる
   * - 行末に来たとき: **空いていた右半分が版面に残らない**ので、浮いて見える量が半分になる
   *
   * `hanging-punctuation: allow-end`（Safariのみ対応）や、折り返す幅だけを
   * メディアクエリで狙って `-1em` する案は採らない。前者はChrome/Firefoxで何も起きず、
   * 後者は**1行に収まる幅で次の字と重なる**ため、折り返す幅の飛び地を正確に言い当てる必要がある
   * （カードは 320-375 / 768-1022 / 1024以上 と飛び飛びで、幅の条件が変わるたびに壊れる）。
   * -0.5em は**どちらの状態でも成立する唯一の値**なので、条件分岐を持たない。
   */
  .ja-tight-comma {
    margin-right: -0.5em;
  }
</style>
