---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import HeroSection from "../components/HeroSection.astro";
import SolutionSection from "../components/SolutionSection.astro";
import ServicesSection from "../components/ServicesSection.astro";
import FeaturesSection from "../components/FeaturesSection.astro";
import ProfileSection from "../components/ProfileSection.astro";
import CurriculumSection from "../components/CurriculumSection.astro";
import IndustryCardsSection from "../components/IndustryCardsSection.astro";
import CaseStudySection from "../components/CaseStudySection.astro";
import FlowSection from "../components/FlowSection.astro";
import CtaSection from "../components/CtaSection.astro";
import Footer from "../components/Footer.astro";
import { site } from "../data/content";
---

<Layout title={site.title} description={site.description}>
  <Header />
  {/*
    **元のトップの並びは変えない**。業種カードだけを研修の直後・事例の前に差し込む
    （2026-08-06 なおき決定。「研修 → 業種カード」の隣接だけを作る最小の差し込み）。
    ナビ（content.ts の nav）は #id へのフラグメントなので、並びを変えても壊れない。
    位置を動かすときは <IndustryCardsSection /> の1行を上下させるだけでよい。
  */}
  <main>
    <HeroSection />
    <SolutionSection />
    <ServicesSection />
    <FeaturesSection />
    <ProfileSection />
    <CurriculumSection />
    <IndustryCardsSection />
    <CaseStudySection />
    <FlowSection />
    <CtaSection />
  </main>
  <Footer />
</Layout>
