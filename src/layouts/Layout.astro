---
import "../styles/global.css";
import { tracking } from "../data/content";

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
// GA4（合計流入のみ。個社特定はtoken側）。ga4Idが空ならタグを出さない
const GA_ID = tracking.ga4Id;

// base path を含めた favicon パス（Astro の base 設定に追従）
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
// ?v= はキャッシュ無効化用（ファビコン更新時にバージョンを上げる）
const faviconHref = `${base}/favicon.svg?v=coregen-dots2`;
// OGP画像（絶対URL。SNSは相対パス不可）。?v= は更新時のキャッシュ無効化用
const ogImage = new URL(`${base}/ogp.png?v=1`, Astro.site).href;
// 現在ページの正規URL（canonical / og:url 用。クエリ・末尾は正規化）
const canonical = new URL(Astro.url.pathname, Astro.site).href;
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="CoreGen" />
    <meta property="og:locale" content="ja_JP" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImage} />
    <link rel="icon" type="image/svg+xml" href={faviconHref} />
    <link rel="alternate icon" href={faviconHref} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <!-- AI顧問LP（campaigns/ai-advisor）と同一の書体。明朝=見出し／ゴシック=本文・英字ラベル -->
    <link
      href="https://fonts.googleapis.com/css2?family=Shippori+Mincho:wght@600;700&family=Zen+Kaku+Gothic+New:wght@400;500;700&display=swap"
      rel="stylesheet"
    />
    <title>{title}</title>
    {GA_ID && (
      <Fragment>
        <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${GA_ID}`}></script>
        <script is:inline set:html={`window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments);}gtag('js',new Date());gtag('config','${GA_ID}');`}></script>
      </Fragment>
    )}
  </head>
  <body>
    <slot />
    <script>
      // Scroll-reveal animation using IntersectionObserver.
      // Replaces AOS library which fails on mobile Safari due to
      // offsetTop calculation bugs with overflow-x:hidden.
      function initScrollReveal() {
        const targets = document.querySelectorAll<HTMLElement>("[data-animate]");
        if (!targets.length) return;

        // Apply per-element transition-delay from data-delay attribute
        targets.forEach((el) => {
          const delay = el.dataset.delay;
          if (delay) {
            el.style.transitionDelay = `${delay}ms`;
          }
        });

        const observer = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add("is-visible");
                observer.unobserve(entry.target);
              }
            });
          },
          {
            // Trigger when 10% of the element is visible,
            // or when it is within 40px of the viewport bottom
            threshold: 0.1,
            rootMargin: "0px 0px -40px 0px",
          }
        );

        targets.forEach((el) => observer.observe(el));
      }

      // Run after DOM is ready (module scripts are deferred by default)
      initScrollReveal();
    </script>
    <script>
      // ユニークリンク(?c=token)の訪問ビーコン。全ページで1回。token無ければ何もしない。
      import { getToken, trackCta, trackVisit } from "../lib/track";
      import { initEngage, markCtaClick } from "../lib/engage";
      import { tracking } from "../data/content";
      const cgToken = getToken();
      trackVisit(tracking.logUrl, cgToken, location.pathname);

      /*
       * LP内の行動計測（2026-08-27 新設）。どのセクションまで読んで帰ったか・
       * どれだけ見ていたかを、離脱時にまとめて1回だけ送る。詳細は lib/engage.ts。
       * ページのLP版(?v=)は、このページのCTAリンクが持っている値から拾う
       * （業種LPなら mfg_v1 等・トップLPなら top_v1。値の正本は industries.ts の ctaUrl 側）。
       */
      const ctaHref = document.querySelector("a[href*='cta=']")?.getAttribute("href") || "";
      const pageVersion = new URLSearchParams(ctaHref.split("?")[1] || "").get("v") || "";
      initEngage({
        logUrl: tracking.logUrl,
        token: cgToken,
        page: location.pathname,
        version: pageVersion,
      });

      /*
       * LP内のCTAクリック計測（2026-08-27 新設）。
       *
       * **個々のボタンには手を入れず、document 1本の委譲リスナーで拾う。**
       * CTAは `ui/Button.astro`（トップLPと業種LPの共用部品）を含む5コンポーネント・
       * 計8箇所に散っているので、個別に onclick を足すと共用部品にまで手が入る。
       * 委譲ならマークアップは1文字も変わらず、トップ・業種・ヘッダーを一度に拾える。
       *
       * 位置(cta=)とLP版(v=)は**リンク自身のクエリから読む**＝リンクを増やしても
       * ここを直さなくてよい（値の正本は industries.ts の ctaUrl() 側にある）。
       *
       * なぜ計測が要るのか: ビーコンが送っているのは pathname だけなので、
       * 「業種LP → /download/」という並びが**LP内CTAを押した結果**なのか
       * **営業文の▼資料リンクを別に押しただけ**なのかが区別できなかった
       * （実測で逆順の並びも実在した）。dest と position を送って初めて分かれる。
       */
      const base = import.meta.env.BASE_URL.replace(/\/$/, "");
      const CTA_PATH = new RegExp(`^${base}/(reserve|download)/?$`);
      document.addEventListener(
        "click",
        (ev) => {
          const target = ev.target;
          if (!(target instanceof Element)) return;
          const a = target.closest("a[href]");
          if (!a) return;
          let url: URL;
          try {
            url = new URL(a.getAttribute("href") || "", location.href);
          } catch {
            return; // mailto: や tel: など
          }
          if (url.origin !== location.origin) return;
          const m = CTA_PATH.exec(url.pathname);
          if (!m) return;
          markCtaClick(); // 行動計測の側にも「このページでCTAを押した」を残す
          trackCta(tracking.logUrl, cgToken, {
            page: location.pathname,
            position: url.searchParams.get("cta") || "",
            dest: m[1],
            version: url.searchParams.get("v") || "",
          });
        },
        // capture: 途中の要素が stopPropagation しても取りこぼさない
        // passive: preventDefault は一切しない（遷移を邪魔しない）
        { capture: true, passive: true }
      );
    </script>
  </body>
</html>
